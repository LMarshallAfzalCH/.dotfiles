#!/usr/bin/env bash
alias cp='cp -iv' # Prompts before overwriting files
alias ls='ls --color=auto' # List all files
alias la='ls --color=auto -alhF' # List all files, including hidden files, with a nice format
alias ll='ls --color=auto -ltrhF' # List all files, including hidden files, with a nice format
alias mv='mv -iv' # Prompts before overwriting files
alias rm='rm -v'
alias mkdir='mkdir -pv' # Create directories, including parent directories if necessary
alias wget='wget -c' # Continue downloading interrupted downloads
alias cd='cd -P' # Change directories, following symbolic links only once
alias clr='clear && printf "\033[3J\033[H"' # Clear the screen and move the cursor to the top
alias hist='history' # Write the history to a file
alias tree='tree -C' # Show the directory tree with colors
alias grep='grep --color=auto'

alias ..='cd ..' # Change to parent directory
alias ...='cd ../..' # Change to grandparent directory
alias ....='cd ../../..' # Change to great-grandparent directory

alias py3='python3'
alias pym='python3 manage.py'
alias mkvenv='python3 -m venv venv' # Create python virtual environment
alias startvenv='source venv/bin/activate && which python3' # Start vitual environment
alias stopvenv='deactivate venv' # Stop virtual environment

alias ewfbep='connect_instance ewf-bep hl'
alias xmlbep='connect_instance xml-bep hl'
alias chdbep='connect_intance chd-bep hl'

alias filtuxlive1='connect_instance fil-tuxedo-live-1 hl'
alias filtuxstg1='connect_instance fil-tuxedo-staging-1 hs'

alias tux1='connect_instance frontend-tuxedo-live-1 hl'
alias tux2='connect_instance frontend-tuxedo-live-2 hl'
alias tux3='connect_instance frontend-tuxedo-live-3 hl'

alias slave1='ssh -i ~/.ssh/ch-aws-live.pem ec2-user@mesos-slave1.live.aws.internal'
alias slave2='ssh -i ~/.ssh/ch-aws-live.pem ec2-user@mesos-slave1.live.aws.internal'
alias slave3='ssh -i ~/.ssh/ch-aws-live.pem ec2-user@mesos-slave1.live.aws.internal'
